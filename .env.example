# TOTEN Environment Variables
# Copy this file to .env and fill in real values

# ─── Database ───
DB_USER=toten
DB_PASSWORD=change_me_in_production
DB_HOST=postgres
DB_PORT=5432
DB_NAME=toten_db

# ─── Redis ───
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Auth ───
JWT_SECRET=change_this_to_a_random_64_char_string
TOKEN_EXPIRY=7d

# ─── Service URLs (internal Docker network) ───
USER_SERVICE_URL=http://user-service:3001
AUTH_SERVICE_URL=http://auth-service:3002
MEMBERSHIP_SERVICE_URL=http://membership-service:3003
BOOKING_SERVICE_URL=http://booking-service:3004
MATCH_SERVICE_URL=http://match-service:3005
RANKING_SERVICE_URL=http://ranking-service:3006
TOURNAMENT_SERVICE_URL=http://tournament-service:3007
NOTIFICATION_SERVICE_URL=http://notification-service:3008
FRAUD_SERVICE_URL=http://fraud-service:3009
SPONSOR_SERVICE_URL=http://sponsor-service:3010
FINANCE_SERVICE_URL=http://finance-service:3011
CONTROL_TOWER_URL=http://control-tower:3012

# ─── MinIO / Object Storage ───
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_ENDPOINT=http://minio:9000

# ─── Payment Gateways ───
VNPAY_MERCHANT_ID=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# ─── Notifications ───
FIREBASE_SERVER_KEY=
ZALO_OA_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── App Settings ───
NODE_ENV=development
LOG_LEVEL=info
